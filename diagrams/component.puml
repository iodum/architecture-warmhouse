@startuml
title SmartHome Web Application Component Diagram

top to bottom direction

!includeurl https://raw.githubusercontent.com/RicardoNiepel/C4-PlantUML/master/C4_Component.puml


Container(users, "Сервис управления пользователями") {
    Component(authController, "AuthController", "Авторизация пользователя в системе")
    Component(userRepositoryLayer, "RepositoryLayer", "Data access logic")
}


Container(sensors, "Устройства") {
  Component(sensorController, "SensorController", "Принимает запросы, возвращает ответ клиенту")
  Component(registHandler, "RegistrationHandler", "Добавление нового устройства")
  Component(configHandler, "ConfigurationHandler", "Изменение настроек устройства")

  Component(sensorsRepositoryLayer, "RepositoryLayer", "Data access logic")
}

Container(monitoring, "Мониторинг") {
  Component(monitoringController, "MonitoringController", "Принимает запросы, возвращает ответ клиенту")

  Component(writeHandler, "WriteHandler", "Собирает и обрабатывает данные телеметрии")
  Component(readHandler, "ReadHandler", "Публикует данные телеметрии")

  Component(monitoringRepositoryLayer, "RepositoryLayer", "Data access logic")
}

ContainerDb(Database, "База Данных", "PostgreSQL", "Хранит данные о пользователях и устройствах")


Rel(authController,userRepositoryLayer,"Использует")
Rel(userRepositoryLayer,Database,"Чтение и запись данных пользователя")

Rel(sensorController,registHandler,"Использует")
Rel(sensorController,configHandler,"Использует")
Rel(registHandler,sensorsRepositoryLayer,"Чтение и запись данных")
Rel(configHandler,sensorsRepositoryLayer,"Чтение и запись данных")
Rel(sensorsRepositoryLayer,Database,"Чтение и запись данных об устройстве")

Rel(monitoringController,writeHandler,"Использует")
Rel(monitoringController,readHandler,"Использует")
Rel(writeHandler,monitoringRepositoryLayer,"Чтение и запись данных")
Rel(readHandler,monitoringRepositoryLayer,"Чтение и запись данных")
Rel(monitoringRepositoryLayer,Database,"Чтение и запись данных телеметрии")

@enduml

@startuml
title SmartHome Container Diagram

top to bottom direction

!includeurl https://raw.githubusercontent.com/RicardoNiepel/C4-PlantUML/master/C4_Component.puml

Person(user, "Пользователь", "Пользователь умного дома")
System_Ext(sensor, "Устройство", "Модуль для умного дома")

Container(webApp, "Web Application", "Go")
Container(api, "API", "Go", "Маршрутизирует запросы")

Container(users, "Сервис управления пользователями", "Управляет добавлением, авторизаций пользователя")
Container(sensors, "Сервис управления устройствами", "Управляет добавлением новых устройств, настройками, состоянием")
Container(monitoring, "Управление мониторингом", "Собирает и публикует данные телеметрии")

ContainerDb(Database, "База Данных", "PostgreSQL", "Хранит данные о пользователях и устройствах")


Rel(sensor, api, "Отправляет данные телеметрии, получает настройки, состояния")
Rel(user, webApp, "Использует систему")
Rel(webApp,api,"Чтение и запись данных")
Rel(api,users,"Использует сервис")
Rel(api,sensors,"Использует сервис")
Rel(api,monitoring,"Использует сервис")
Rel(users,Database,"Чтение и запись данных")
Rel(sensors,Database,"Чтение и запись данных")
Rel(monitoring,Database,"Чтение и запись данных")

@enduml
